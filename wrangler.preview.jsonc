{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doaa-calibration-preview",
  "compatibility_date": "2026-10-06",
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doaa-memory-preview",
      "database_id": "939eda3b-4894-497b-9f67-209771761b3f",
      "migrations_dir": "migrations"
    }
  ]
}
