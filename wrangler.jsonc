{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doaa-calibration",
  "compatibility_date": "2026-10-06",
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}