{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doaa-calibration",
  "compatibility_date": "2026-10-06",
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doaa-memory",
      "database_id": "434f90d3-397b-48d3-8249-4c48cf1e8936",
      "migrations_dir": "migrations"
    }
  ]
}
